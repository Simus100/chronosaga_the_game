{
  "name": "chronosaga-the-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @paa/web --filter @paa/server dev",
    "dev:web": "pnpm --filter @paa/web dev",
    "dev:server": "pnpm --filter @paa/server dev",
    "dev:desktop": "pnpm --filter @paa/desktop dev",
    "dev:desktop:ai": "pnpm verify:local-ai-runtime && pnpm dev:desktop",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @paa/game-core test && pnpm --filter @paa/ai-contracts test",
    "lint": "pnpm -r lint --if-present",
    "verify:local-ai-runtime": "node scripts/verify-local-ai-runtime.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
