{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronosaga The Game",
  "version": "0.1.0",
  "identifier": "it.universalis.chronosaga",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @paa/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Chronosaga: The Game",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../../../models/manifest.json"
    ]
  }
}
